<Window x:Class="QwenPlayground.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QwenPlayground Launcher"
        Width="560" Height="680" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="QwenPlayground" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="12"
                       Foreground="{StaticResource DimBrush}" Text="…" />
            <TextBlock x:Name="BuildStatusText" Margin="0,2,0,0" FontSize="11"
                       Foreground="{StaticResource DimBrush}" Text="" />
            <TextBlock x:Name="GitStatusText" Margin="0,2,0,0" FontSize="11"
                       Foreground="{StaticResource DimBrush}" Text="" />
        </StackPanel>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Margin="0,12,0,0" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4,4,0,0" Padding="16,6" Margin="0,0,4,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ===== Вкладка: Главная ===== -->
            <TabItem Header="Главная">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="▶  Запустить" Style="{StaticResource AccentButton}"
                                Padding="18,8" FontSize="13" Click="StartButton_Click" />
                        <Button x:Name="RebuildButton" Content="⚙  Пересобрать"
                                Margin="8,0,0,0" Padding="14,8" Click="RebuildButton_Click" />
                    </StackPanel>

                    <!-- GitHub -->
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="GitHub" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Button x:Name="PullButton" Content="Pull" Padding="12,5" Click="PullButton_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Инструменты -->
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Инструменты" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel x:Name="ToolsPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Окружение -->
                    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Окружение" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel x:Name="EnvPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Статус -->
                    <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0"
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimBrush}" />

                    <!-- Лог -->
                    <Border Grid.Row="5" Background="{StaticResource InputBrush}" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="launcher.log" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource DimBrush}" Margin="8,6,0,4" />
                            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalScrollBarVisibility="Auto" FontSize="10"
                                     FontFamily="Consolas" Padding="8,0,4,8" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Вкладка: Настройки ===== -->
            <TabItem Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Репозиторий -->
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="4"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Репозиторий" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="URL" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,0,2" />
                                <TextBox x:Name="RepoUrlBox" FontSize="11" />
                                <TextBlock Text="Ветка" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,8,0,2" />
                                <TextBox x:Name="BranchBox" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Инструменты (настройки) -->
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="4"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Инструменты" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock x:Name="ToolsConfigText" FontSize="11" Foreground="{StaticResource DimBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Кнопки -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveSettingsButton" Content="Сохранить" Style="{StaticResource AccentButton}"
                                    Padding="16,6" Click="SaveSettingsButton_Click" />
                            <Button x:Name="ResetSettingsButton" Content="Сбросить"
                                    Margin="8,0,0,0" Padding="12,6" Click="ResetSettingsButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
