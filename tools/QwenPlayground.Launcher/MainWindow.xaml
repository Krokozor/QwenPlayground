<Window x:Class="QwenPlayground.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QwenPlayground Launcher"
        Width="620" Height="460"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock FontSize="18" FontWeight="Bold" Text="QwenPlayground" />
        <TextBlock x:Name="VersionText" Margin="0,4,0,0" Text="…" />
        <TextBlock x:Name="BuildStatusText" Margin="0,2,0,0" Text="" Foreground="#666" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="StartButton" Content="Запустить приложение" Padding="14,6" Click="StartButton_Click" />
            <Button x:Name="RebuildButton" Content="Пересобрать и запустить" Padding="14,6" Margin="8,0,0,0" Click="RebuildButton_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Последние строки launcher.log" FontWeight="Bold" FontSize="12" Margin="0,12,0,4" />
        <TextBox x:Name="LogBox" IsReadOnly="True" Height="170" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontSize="11" FontFamily="Consolas" />
    </StackPanel>
</Window>
