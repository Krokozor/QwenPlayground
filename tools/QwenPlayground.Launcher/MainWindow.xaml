<Window x:Class="QwenPlayground.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QwenPlayground Launcher"
        Width="680" Height="620"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock FontSize="18" FontWeight="Bold" Text="QwenPlayground" />
        <TextBlock x:Name="VersionText" Margin="0,4,0,0" Text="…" />
        <TextBlock x:Name="BuildStatusText" Margin="0,2,0,0" Text="" Foreground="#666" />
        <TextBlock x:Name="GitStatusText" Margin="0,2,0,0" Text="" Foreground="#666" />

        <!-- Основные кнопки -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="StartButton" Content="Запустить" Padding="14,6" Click="StartButton_Click" />
            <Button x:Name="RebuildButton" Content="Пересобрать" Padding="14,6" Margin="8,0,0,0" Click="RebuildButton_Click" />
        </StackPanel>

        <!-- GitHub -->
        <TextBlock Text="GitHub" FontWeight="Bold" FontSize="13" Margin="0,16,0,4" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="PullButton" Content="Pull" Padding="14,6" Click="PullButton_Click" />
            <Button x:Name="PullRebuildButton" Content="Pull + Rebuild" Padding="14,6" Margin="8,0,0,0" Click="PullRebuildButton_Click" />
        </StackPanel>

        <!-- Инструменты -->
        <TextBlock Text="Инструменты" FontWeight="Bold" FontSize="13" Margin="0,16,0,4" />
        <StackPanel x:Name="ToolsPanel" Margin="0,4,0,0">
            <!-- Заполняется динамически -->
        </StackPanel>

        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Последние строки launcher.log" FontWeight="Bold" FontSize="12" Margin="0,12,0,4" />
        <TextBox x:Name="LogBox" IsReadOnly="True" Height="150" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontSize="11" FontFamily="Consolas" />
    </StackPanel>
</Window>
