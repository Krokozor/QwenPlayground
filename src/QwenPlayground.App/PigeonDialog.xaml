<Window x:Class="QwenPlayground.App.PigeonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pigeon — подключение чата" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Подключение этого чата к pigeon-серверу (docs/MESSANGER.md)"
                   FontWeight="Bold" Margin="0,0,0,2" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   FontSize="11" Foreground="{StaticResource DimBrush}">
            <Run Text="Идентичность = этот чат: " />
            <Run x:Name="IdRun" FontFamily="Consolas" />
            <Run Text=". Алиас присваивается автоматически (= guid); модель — экстра, из llama.cpp." />
        </TextBlock>

        <!-- Статус подключения: всегда виден, цвет = состояние. -->
        <Border x:Name="StatusBorder" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
            <TextBlock x:Name="StatusLine" Text="не подключено" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Адрес сервера (список каналов обновляется сам, пока окно открыто):" Margin="0,0,0,3" />
        <TextBox x:Name="EndpointBox" Padding="4,3" Margin="0,0,0,10" TextChanged="Endpoint_Changed"
                 ToolTip="http://host:port (по умолчанию http://127.0.0.1:8199)" />

        <TextBlock Text="Канал (фаза 0: один канал на участника; «без канала» — подключиться, не садясь):" Margin="0,0,0,3" />
        <Border BorderThickness="1" CornerRadius="4" Background="#1b1e24" MaxHeight="180" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChannelList" Margin="4" />
            </ScrollViewer>
        </Border>

        <TextBlock Text="Статус («что делаю», виден в who-панели; меняется в любой момент):" Margin="0,0,0,3" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="StatusBox" Grid.Column="0" Padding="4,3" />
            <Button x:Name="SaveStatusButton" Grid.Column="1" Content="сохранить" Margin="6,0,0,0" Padding="8,2"
                    Click="SaveStatus_Click"
                    ToolTip="Подключён — сразу на сервер; не подключён — в pigeon.json (применится при подключении)" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ToggleButton" Content="Подключить" IsDefault="True" Click="Toggle_Click" Padding="14,4"
                    ToolTip="Одна кнопка-переключатель: подключено — отключает, не подключено — подключает" />
            <Button Content="Закрыть" IsCancel="True" Padding="14,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
