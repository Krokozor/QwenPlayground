<Window x:Class="QwenPlayground.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QwenPlayground.App.ViewModels"
        xmlns:views="clr-namespace:QwenPlayground.App.Views"
        mc:Ignorable="d"
        Title="QwenPlayground" Height="760" Width="1040">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <DockPanel>
        <!-- Диспетчер ходов: фоновые работы с личностью (реестр) вместо одной статусной строки -->
        <Expander DockPanel.Dock="Bottom" Header="{Binding TurnsPanel.Summary}" Margin="4,0,4,4"
                  Foreground="{StaticResource DimBrush}">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                    Background="{StaticResource PanelBrush}" MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TurnsPanel.Items}" Padding="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StateText}" FontSize="11"
                                                   Foreground="{Binding StateBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                                    TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11"
                                                    HorizontalAlignment="Right" Foreground="{StaticResource DimBrush}" />
                                        <Button Grid.Column="3" Content="отменить" FontSize="10" Padding="6,1"
                                                Margin="8,0,0,0" Click="TurnCancel_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>
        <TabControl Margin="4" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Чат">
                <views:ChatView DataContext="{Binding}" />
            </TabItem>
            <TabItem Header="Превью промпта">
                <views:PreviewView DataContext="{Binding}" />
            </TabItem>
            <TabItem Header="Настройки">
                <views:SettingsView DataContext="{Binding}" />
            </TabItem>
            <TabItem Header="Память">
                <views:MemoryView DataContext="{Binding Memory}" />
            </TabItem>
            <TabItem Header="Суммаризация">
                <views:SummarizationView DataContext="{Binding Summarization}" />
            </TabItem>
            <TabItem Header="Диагностика">
                <views:DiagnosticsView DataContext="{Binding Diagnostics}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
