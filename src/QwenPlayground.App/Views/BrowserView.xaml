<UserControl x:Class="QwenPlayground.App.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button Content="⟳" DockPanel.Dock="Right" Padding="8,2" Margin="4,0,0,0"
                    Click="Refresh_Click" ToolTip="Обновить" />
            <Button Content="→" DockPanel.Dock="Right" Padding="8,2" Margin="4,0,0,0"
                    Click="Forward_Click" ToolTip="Вперёд" />
            <Button Content="←" DockPanel.Dock="Right" Padding="8,2" Margin="4,0,0,0"
                    Click="Back_Click" ToolTip="Назад" />
            <Button Content="📸" DockPanel.Dock="Right" Padding="8,2" Margin="4,0,0,0"
                    Click="Screenshot_Click" ToolTip="Скриншот" />
            <TextBox x:Name="UrlBar" Width="500" Margin="4,0"
                     VerticalContentAlignment="Center" Padding="4,2"
                     Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#3a5a7a"
                     KeyDown="UrlBar_KeyDown" />
            <TextBlock Text="🌐 Браузер агента" VerticalAlignment="Center" Foreground="#8be9fd" FontSize="13" />
        </DockPanel>

        <!-- Screenshot area -->
        <Border Grid.Row="1" BorderBrush="#3a5a7a" BorderThickness="1" CornerRadius="3" Background="#0a0a0f">
            <Image x:Name="ScreenshotImage" Stretch="Uniform" Margin="4" />
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                   Text="Открыть вкладку и нажать 📸 для скриншота. Браузер работает headless." />
    </Grid>
</UserControl>
