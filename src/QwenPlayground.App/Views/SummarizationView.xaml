<UserControl x:Class="QwenPlayground.App.Views.SummarizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QwenPlayground.App.Views">
    <UserControl.Resources>
        <views:InverseBoolConverter x:Key="InverseBool" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Единый поток по секциям (session-centric). main и не-main равноправны: слои L1/L2/L3
             у всех. Каждое объёмное поле — Expander. -->
        <StackPanel Margin="16">
            <TextBlock Text="Суммаризация и слои памяти" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="Выберите сессию — слои L1/L2/L3 относятся к ней. "
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8" />

            <ComboBox ItemsSource="{Binding Sessions}" DisplayMemberPath="Title"
                      SelectedItem="{Binding SelectedSession}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding SessionNote}" FontSize="11" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <!-- Слои сессии (L1/L2/L3) — унифицированный вид, главный -->
            <Expander Header="Слои сессии (L1/L2/L3)" IsExpanded="True" Margin="0,0,0,8">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Долгосрочная память: L3 — свежие события, L2 — средний слой, L1 — старый дистиллят."
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Expander Header="L1 (самый старый)" IsExpanded="False" Margin="0,2,0,4">
                        <TextBox Text="{Binding Layer1, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="60" MaxHeight="240"
                                 VerticalScrollBarVisibility="Auto" FontSize="11" />
                    </Expander>
                    <Expander Header="L2 (средний)" IsExpanded="False" Margin="0,2,0,4">
                        <TextBox Text="{Binding Layer2, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="60" MaxHeight="240"
                                 VerticalScrollBarVisibility="Auto" FontSize="11" />
                    </Expander>
                    <Expander Header="L3 (свежие события)" IsExpanded="True" Margin="0,2,0,4">
                        <TextBox Text="{Binding Layer3, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="60" MaxHeight="240"
                                 VerticalScrollBarVisibility="Auto" FontSize="11" />
                    </Expander>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Сбросить из файла" Command="{Binding LoadLayersCommand}" Padding="10,4" />
                        <Button Content="Сохранить слои (с бэкапом)" Command="{Binding SaveLayersCommand}"
                                Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding LayersStatus}" FontSize="11" Foreground="Gray"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Expander Header="Блок в системный промпт (как пойдёт модели)" IsExpanded="False" Margin="0,6,0,0">
                        <TextBox Text="{Binding LayersPromptBlock, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 MinHeight="40" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" />
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Промпты суммаризации (общие, config/prompts.json) -->
            <Expander Header="Промпты суммаризации (config/prompts.json)" IsExpanded="False" Margin="0,0,0,8">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Правка действует на следующий прогон/компакцию. Шаблон: «{{key}}» заменяется на данные."
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding PromptSteps}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedStep}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding PromptStatus}" FontSize="11" Foreground="Gray"
                               TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SelectedStep.Template, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="0,2,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Сохранить шаблон" Command="{Binding SavePromptTemplateCommand}" Padding="10,4" />
                        <Button Content="Сбросить к дефолту" Command="{Binding ResetPromptTemplateCommand}"
                                Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <Expander Header="Итоговый промпт этого шага" IsExpanded="False" Margin="0,6,0,0">
                        <TextBox Text="{Binding StepRenderedPrompt, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="NoWrap" AcceptsReturn="True" MinHeight="80" MaxHeight="260"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" />
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Ре-прогон (на выбранной сессии) -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Ре-прогон (на выбранной сессии)" FontWeight="Bold" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Прогнать конвейер L1/L2/L3" Command="{Binding RerunPipelineCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                Padding="10,4" Margin="8,0,0,0" />
                        <Button Content="Очистить" Command="{Binding ClearRunCommand}" Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Записать слои" Command="{Binding ApplyProposedLayersCommand}"
                                Visibility="{Binding HasLayerProposal, Converter={StaticResource BoolToVisibility}}"
                                Padding="10,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding RunStatus}" TextWrapping="Wrap" FontSize="11"
                               Foreground="Gray" Margin="0,6,0,0" />
                    <Expander Header="Вывод прогона" IsExpanded="True" Margin="0,4,0,0">
                        <TextBox Text="{Binding RunOutput, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="NoWrap" AcceptsReturn="True" MinHeight="100" MaxHeight="300"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
