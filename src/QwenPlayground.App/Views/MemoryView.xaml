<UserControl x:Class="QwenPlayground.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QwenPlayground.App.Views">
    <UserControl.Resources>
        <views:InverseBoolConverter x:Key="InverseBool" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:NullObjectToVisibilityConverter x:Key="NullObjectToVisibility" />

        <!-- Акценты состояния (тёмная палитра дома) -->
        <SolidColorBrush x:Key="WarnBrush" Color="#d16969" />
        <SolidColorBrush x:Key="OkBrush" Color="#7ec699" />
        <SolidColorBrush x:Key="AccentABrush" Color="#6caeed" />
        <SolidColorBrush x:Key="AccentBBrush" Color="#8fce93" />

        <!-- Карточка факта в списке -->
        <DataTemplate x:Key="FactCard">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,2">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="5,0"
                            Command="{Binding DataContext.DeleteFactCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding Id}"
                            ToolTip="Удалить факт"
                            VerticalAlignment="Top" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text="{Binding Emoji}" FontSize="11" Margin="5,0,0,0" />
                            <TextBlock Text="{Binding CreatedAt, StringFormat='  {0:MM.dd HH:mm}'}"
                                       FontSize="10" Foreground="{StaticResource DimBrush}" Margin="8,0,0,0" />
                            <TextBlock Text="без слоёв" FontSize="10" Foreground="{StaticResource WarnBrush}"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding HasLayers, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Content}" FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Id}" FontSize="9" FontFamily="Consolas"
                                   Foreground="{StaticResource DimBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Карточка пары-кандидата: факторы решения + содержимое с переносами + кнопки на месте -->
        <DataTemplate x:Key="PairCard">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,3">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="10" FontFamily="Consolas"
                                   Foreground="{StaticResource DimBrush}">
                            <Run Text="{Binding IdA, Mode=OneWay}" /><Run Text="  ~  " /><Run Text="{Binding IdB, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="Смерджить" Command="{Binding DataContext.MergePairCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Padding="6,1" FontSize="10" Margin="4,0,0,0" />
                            <Button Content="Не похоже" Command="{Binding DataContext.NotSimilarPairCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Padding="6,1" FontSize="10" Margin="4,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock FontSize="10" Margin="0,3,0,0">
                        <Run Text="фактор схожести гистограмм: " Foreground="{StaticResource DimBrush}" />
                        <Run Text="{Binding HistOverlap, Mode=OneWay, StringFormat={}{0:0.00}}" FontWeight="Bold" />
                        <Run Text="   ·   классификатор: " Foreground="{StaticResource DimBrush}" />
                        <Run Text="{Binding DigitScore, Mode=OneWay, StringFormat={}{0:0.0}}" FontWeight="Bold" />
                        <Run Text=" (энтропия " Foreground="{StaticResource DimBrush}" />
                        <Run Text="{Binding Entropy, Mode=OneWay, StringFormat={}{0:0.00}}" />
                        <Run Text=")" Foreground="{StaticResource DimBrush}" />
                    </TextBlock>
                    <TextBlock FontSize="10" Margin="0,3,0,0">
                        <Run Text="фактор схожести гистограмм: " Foreground="{StaticResource DimBrush}" />
                        <Run Text="{Binding HistOverlap, Mode=OneWay, StringFormat={}{0:0.00}}" FontWeight="Bold" />
                        <Run Text="   ·   классификатор: " Foreground="{StaticResource DimBrush}" />
                        <Run Text="{Binding DigitScore, Mode=OneWay, StringFormat={}{0:0.0}}" FontWeight="Bold" />
                        <Run Text=" (энтропия " Foreground="{StaticResource DimBrush}" />
                        <Run Text="{Binding Entropy, Mode=OneWay, StringFormat={}{0:0.00}}" />
                        <Run Text=")" Foreground="{StaticResource DimBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="A:" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource AccentABrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ContentA}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource FgBrush}" MaxWidth="620" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="B:" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource AccentBBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ContentB}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource FgBrush}" MaxWidth="620" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Карточка разведённой связи -->
        <DataTemplate x:Key="DistinctCard">
            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,3">
                <StackPanel>
                    <DockPanel>
                        <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource DimBrush}">
                            <Run Text="{Binding IdA, Mode=OneWay}" /><Run Text="  ~  " /><Run Text="{Binding IdB, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="↩ в кандидаты" Command="{Binding DataContext.UnmarkDistinctPairCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" Padding="6,1" FontSize="10"
                                HorizontalAlignment="Right" DockPanel.Dock="Right" />
                    </DockPanel>
                    <TextBlock Text="{Binding ContentA}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource AccentABrush}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding ContentB}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource AccentBBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="7*" MinWidth="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Строка состояния: здоровье памяти без прокрутки -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,5" Margin="0,0,0,8">
            <UniformGrid Columns="5">
                <TextBlock FontSize="11">
                    <Run Text="Фактов: " Foreground="{StaticResource DimBrush}" />
                    <Run Text="{Binding Memories.Count, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock FontSize="11">
                    <Run Text="Без векторов: " Foreground="{StaticResource DimBrush}" />
                    <Run Text="{Binding UnvectorizedCount, Mode=OneWay}" FontWeight="Bold"
                         Foreground="{StaticResource WarnBrush}" />
                </TextBlock>
                <TextBlock FontSize="11">
                    <Run Text="Пар в очереди: " Foreground="{StaticResource DimBrush}" />
                    <Run Text="{Binding PendingPairs.Count, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock FontSize="11">
                    <Run Text="Разведено: " Foreground="{StaticResource DimBrush}" />
                    <Run Text="{Binding DistinctCount, Mode=OneWay}" FontWeight="Bold"
                         Foreground="{StaticResource OkBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding ModeText}" FontSize="11"
                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" />
            </UniformGrid>
        </Border>

        <!-- ── Левая колонка: валидатор ── -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
            <TextBlock Text="Валидатор надмоза" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="Ручной тест классификации и реколла на компаньон-модели."
                       FontSize="11" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />

            <TextBlock Text="Тестовый текст / вектор диалога" FontSize="11" Foreground="{StaticResource DimBrush}" />
            <TextBox Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="110" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                     Margin="0,4,0,8" FontSize="12" />

            <UniformGrid Columns="2">
                <Button Content="Классифицировать" Command="{Binding ClassifyCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Padding="8,4" Margin="0,0,4,4" />
                <Button Content="Реколл" Command="{Binding RecallCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Padding="8,4" Margin="4,0,0,4" />
                <Button Content="Дочистить векторы" Command="{Binding FlushCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Padding="8,4" Margin="0,0,4,4" />
                <Button Content="Обновить всё" Command="{Binding RefreshMemoriesCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Padding="8,4" Margin="4,0,0,4" />
            </UniformGrid>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource DimBrush}" Margin="0,6,0,0" />

            <TextBlock Text="Сырые буквы модели (аргмакс по позициям)" FontSize="11"
                       Foreground="{StaticResource DimBrush}" Margin="0,10,0,2"
                       Visibility="{Binding RawLetters, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Text="{Binding RawLetters}" FontWeight="Bold" FontSize="13" FontFamily="Consolas"
                       Visibility="{Binding RawLetters, Converter={StaticResource NullToVisibility}}" />

            <TextBlock Text="Сырые эмодзи модели" FontSize="11" Foreground="{StaticResource DimBrush}"
                       Margin="0,8,0,2"
                       Visibility="{Binding RawEmoji, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Text="{Binding RawEmoji}" FontSize="13" FontFamily="Consolas"
                       Visibility="{Binding RawEmoji, Converter={StaticResource NullToVisibility}}" />

            <TextBlock Text="Распределение категорий теста (A-Z)" FontWeight="Bold" FontSize="12" Margin="0,12,0,4" />
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Letter}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" />
                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource DimBrush}"
                                       Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="2" Height="8" VerticalAlignment="Center"
                                         Maximum="1" Value="{Binding Probability}" />
                            <TextBlock Grid.Column="3" Text="{Binding Probability, StringFormat='{}{0:0.00}'}"
                                       FontSize="10" Foreground="{StaticResource DimBrush}" Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Эмодзи-вайб теста" FontWeight="Bold" FontSize="12" Margin="0,10,0,4" />
            <ItemsControl ItemsSource="{Binding Emoji}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Emoji}" FontSize="12" />
                            <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center"
                                         Maximum="1" Value="{Binding Probability}" Margin="6,0,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Probability, StringFormat='{}{0:0.00}'}"
                                       FontSize="10" Foreground="{StaticResource DimBrush}" Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Реколл — результат валидатора, живёт здесь же -->
            <TextBlock Text="Реколл по вектору диалога" FontWeight="Bold" FontSize="12" Margin="0,14,0,4"
                       Visibility="{Binding ShowRecall, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding RecallHits}"
                          Visibility="{Binding ShowRecall, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,2">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="10" />
                                    <TextBlock Text="{Binding Category}" FontSize="10" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Emoji}" FontSize="10" Margin="4,0,0,0" />
                                    <TextBlock Text="{Binding Score, StringFormat='~{0:0.00}'}" FontWeight="Bold"
                                               FontSize="10" Foreground="{StaticResource OkBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Rectangle Grid.Row="1" Grid.Column="1" Fill="{StaticResource BorderBrush}" Margin="0,0,14,0" />

        <!-- ── Правая колонка: хранилище, надмозг, связи ── -->
        <TabControl Grid.Row="1" Grid.Column="2" MinHeight="560">

            <!-- Факты: master-detail с редактированием и распределениями классификатора -->
            <TabItem Header="Факты">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Обновить всё" Command="{Binding RefreshMemoriesCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Padding="8,3" FontSize="11" />
                        <Button Content="Сбросить все классификации (записи не трогать)"
                                Command="{Binding ResetClassificationsCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Padding="8,3" FontSize="11" Foreground="{StaticResource WarnBrush}" Margin="8,0,0,0" />
                    </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Memories}"
                                 SelectedItem="{Binding SelectedFact}"
                                 ItemTemplate="{StaticResource FactCard}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="2" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- Деталь выбранного факта: редактирование + распределения классификатора -->
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="8,5" Margin="0,6,0,0"
                            Visibility="{Binding SelectedFact, Converter={StaticResource NullObjectToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource DimBrush}">
                                    <Run Text="{Binding SelectedFact.Id, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding SelectedFact.CreatedAt, Mode=OneWay, StringFormat='MM.dd HH:mm'}" />
                                </TextBlock>
                                <TextBox Text="{Binding FactEditContent, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="11"
                                         MinHeight="80" MaxHeight="150"
                                         VerticalScrollBarVisibility="Auto" Margin="0,4,0,6" />
                                
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Сохранить" Command="{Binding SaveFactCommand}" Padding="8,3" FontSize="11" />
                                    <Button Content="Пересчитать слои" Command="{Binding EnrichFactCommand}"
                                            CommandParameter="{Binding SelectedFact.Id}" Padding="8,3" FontSize="11" Margin="8,0,0,0" />
                                    <Button Content="Удалить факт" Command="{Binding DeleteFactCommand}"
                                            CommandParameter="{Binding SelectedFact.Id}" Padding="8,3" FontSize="11"
                                            Foreground="{StaticResource WarnBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Визуализация работы классификатора на этом факте -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Классификатор: категории" FontSize="11" FontWeight="Bold" Margin="0,0,0,3" />
                                <ItemsControl ItemsSource="{Binding FactCategories}" MaxHeight="120">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Letter}" FontFamily="Consolas" FontSize="10" />
                                                <TextBlock Text="{Binding Name}" FontSize="9"
                                                           Foreground="{StaticResource DimBrush}"
                                                           Grid.Column="1" Margin="4,0,6,0" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="2" Height="7" Maximum="1"
                                                             Value="{Binding Probability}" />
                                                <TextBlock Grid.Column="3" FontSize="9"
                                                           Foreground="{StaticResource DimBrush}"
                                                           Text="{Binding Probability, StringFormat='{}{0:0.00}'}" Margin="6,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Эмодзи" FontSize="11" FontWeight="Bold" Margin="0,8,0,3" />
                                <ItemsControl ItemsSource="{Binding FactEmoji}" MaxHeight="90">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Emoji}" FontSize="11" />
                                                <ProgressBar Grid.Column="1" Height="7" Maximum="1"
                                                             Value="{Binding Probability}" Margin="4,0,0,0" />
                                                <TextBlock Grid.Column="2" FontSize="9"
                                                           Foreground="{StaticResource DimBrush}"
                                                           Text="{Binding Probability, StringFormat='{}{0:0.00}'}" Margin="6,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Дубликаты: сканер и очередь пар с факторами решения -->
            <TabItem Header="Дубликаты">
                <StackPanel Margin="6">
                    <Button Content="Скан дубликатов (бюджет из настроек)" Command="{Binding ScanDuplicatesCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Padding="10,4" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Status}" FontSize="11"
                               Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,6,0,6" />
                    <ListBox ItemsSource="{Binding PendingPairs}"
                             ItemTemplate="{StaticResource PairCard}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>


                </StackPanel>
            </TabItem>

            <!-- Связи: все разведённые false-positive классификатора -->
            <TabItem Header="Связи">
                <StackPanel Margin="6">
                    <TextBlock FontSize="11" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"
                               Text="{Binding DistinctCount, StringFormat='Разведённых пар (false positive классификатора): {0}. Они никогда не поднимутся как кандидаты, пока не вернуть в кандидаты.'}" />
                    <ListBox ItemsSource="{Binding DistinctPairs}"
                             ItemTemplate="{StaticResource DistinctCard}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="500"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4" Margin="0,6,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
