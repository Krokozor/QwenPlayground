<UserControl x:Class="QwenPlayground.App.Views.McpSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="McpLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="McpField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="McpCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="80" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,8,0,0">
        <!-- Header + Add button -->
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="AddServerButton" Content="+ Добавить сервер" DockPanel.Dock="Right"
                    Padding="12,4" Click="AddServerButton_Click"
                    ToolTip="Добавить новый MCP-сервер" />
            <TextBlock Text="MCP-серверы" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Server list -->
        <ItemsControl x:Name="ServerList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource DimBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,4">
                        <StackPanel>
                            <!-- Row 1: Name | Transport | Enabled | Test | Remove -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource McpField}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Уникальное имя (в тулах: mcp_{имя}_{тул})" />
                                <ComboBox Grid.Column="1" Style="{StaticResource McpCombo}"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding Transport, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Транспорт: stdio (локальный процесс) или http">
                                    <ComboBoxItem Content="stdio" />
                                    <ComboBoxItem Content="http" />
                                </ComboBox>
                                <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" Margin="12,0,0,0"
                                          VerticalAlignment="Center" ToolTip="Включён" />
                                <Button Grid.Column="4" Content="Тест" Margin="8,0,0,0"
                                        Padding="8,2" Tag="{Binding}" Click="TestServerButton_Click"
                                        ToolTip="Попробовать подключиться" />
                                <Button Grid.Column="5" Content="✕" Margin="6,0,0,0"
                                        Padding="6,2" Tag="{Binding}" Click="RemoveServerButton_Click"
                                        ToolTip="Удалить" />
                            </Grid>

                            <!-- Row 2: Connection details (editable) -->
                            <Grid Margin="0,4,0,0" Visibility="{Binding ShowStdio}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource McpLabel}" Text="команда" />
                                <TextBox Grid.Column="1" Style="{StaticResource McpField}"
                                         Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Путь к исполняемому файлу" />
                            </Grid>
                            <Grid Margin="0,2,0,0" Visibility="{Binding ShowStdio}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource McpLabel}" Text="аргументы" />
                                <TextBox Grid.Column="1" Style="{StaticResource McpField}"
                                         Text="{Binding ArgsText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Аргументы командной строки (через пробел)" />
                            </Grid>
                            <Grid Margin="0,4,0,0" Visibility="{Binding ShowHttp}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource McpLabel}" Text="URL" />
                                <TextBox Grid.Column="1" Style="{StaticResource McpField}"
                                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="HTTP-адрес MCP-сервера" />
                            </Grid>

                            <!-- Row 2b: Description -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource McpLabel}" Text="описание" />
                                <TextBox Grid.Column="1" Style="{StaticResource McpField}"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Краткое описание (видно в таблице MCP Servers в промпте)" />
                            </Grid>

                            <!-- Row 3: Status (after test) -->
                            <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                       Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrush}"
                                       Visibility="{Binding StatusVisibility}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText" Text="Серверы не настроены. Нажмите «+ Добавить сервер»."
                   Foreground="{StaticResource DimBrush}" Margin="0,8"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
