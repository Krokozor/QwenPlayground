<UserControl x:Class="QwenPlayground.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QwenPlayground.App.Views">
    <UserControl.Resources>
        <views:StatusToBrushConverter x:Key="StatusToBrush" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <!-- Тёмная тема (2026-08-22): view был светлым на тёмном приложении — контраст страдал.
         Палитра совпадает с ChatView: карточки #16181d, вложенные #1f2733, текст #e0e0e0/#c0c0c0.
         Foreground на ScrollViewer (Control): наследуется TextBlock'ами вниз. StackPanel не наслед. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#e0e0e0">
        <StackPanel Margin="16">
            <Button Content="Обновить" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <!-- Состояние чата (FSM) -->
            <TextBlock Text="Состояние чата" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
            <Border Background="#16181d" BorderBrush="#444" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding ChatStateName}" FontSize="18" FontWeight="Bold" Foreground="#7aa2f7" />
                    <TextBlock Text="{Binding ChatStateDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#c0c0c0" />
                </StackPanel>
            </Border>

            <!-- Бюджет контекста -->
            <TextBlock Text="Бюджет контекста" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
            <Border Background="#16181d" BorderBrush="#444" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding ContextUsedTokens, StringFormat='Занято: {0} токенов'}" />
                    <TextBlock Text="{Binding ContextSize, StringFormat='Окно: {0} токенов'}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CompactionThreshold, StringFormat='Авто-компакция при ~{0} токенов'}" Margin="0,2,0,0" />
                    <ProgressBar Height="8" Margin="0,8,0,0" Maximum="100" Value="{Binding ContextUsagePercent}" />
                    <TextBlock Text="{Binding ContextUsagePercent, StringFormat='{}{0}% окна'}" Margin="0,4,0,0"
                               HorizontalAlignment="Right" Foreground="#c0c0c0" />
                </StackPanel>
            </Border>

            <!-- KV-слоты llama.cpp: кто сколько удерживает в едином пуле и кнопки чистки.
                 Застарелый KV в слотах замедляет промпт-обработку ВСЕХ слотов —
                 чистка освобождает пул (следующие ходы пере-евалюируют промпты). -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="KV-слоты (llama.cpp)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                <Button Content="вычистить все" Command="{Binding EraseAllSlotsCommand}"
                        HorizontalAlignment="Left" Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center"
                        IsEnabled="{Binding SlotsBusy, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="Вычистить KV всех слотов (с подтверждением): освобождает единый KV-пул" />
            </StackPanel>
            <Border Background="#16181d" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding SlotRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" Margin="0,2" Background="#1f2733">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold" Foreground="#7aa2f7" />
                                        <TextBlock Grid.Column="1" Text="{Binding Role}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Tokens}" Margin="8,0,0,0" Foreground="#c0c0c0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Cache}" Margin="8,0,0,0" FontSize="11" Foreground="#888"
                                                   ToolTip="Токены префикса, переиспользованные в последнем запросе (n_prompt_tokens_cache)." />
                                        <TextBlock Grid.Column="4" Text="{Binding LastUse}" Margin="8,0,0,0" FontSize="11" Foreground="#888"
                                                   ToolTip="Когда приложение последний раз использовало слот. «Застыл» — KV есть, а ходы не трогают больше часа: кандидат на чистку.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stale}" Value="True">
                                                            <Setter Property="Foreground" Value="#e0af68" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="5" Text="обработка…" Margin="8,0,0,0" Foreground="#e0af68"
                                                   HorizontalAlignment="Right"
                                                   Visibility="{Binding Processing, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Grid.Column="6" Orientation="Horizontal">
                                            <TextBlock Text="← текущая" Margin="0,0,8,0" Foreground="#9ece6a"
                                                       Visibility="{Binding IsCurrentSession, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="вычистить" Command="{Binding DataContext.EraseSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" FontSize="10" Padding="6,1" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SlotStatus}" Margin="2,6,2,0" FontSize="11" Foreground="#888" />
                </StackPanel>
            </Border>

            <!-- Метрики сервера: /metrics (флаг llama.cpp "metrics"). Скорости — из дельт
                 кумулятивных счётчиков за интервал поллинга (gauge сервера — среднее
                 за всю жизнь, оно не покажет «вот сейчас упало»). -->
            <TextBlock Text="Метрики сервера (/metrics)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
            <Border Background="#16181d" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Промпт-обработка" FontSize="11" Foreground="#888" />
                            <TextBlock Text="{Binding PromptTps}" FontSize="16" FontFamily="Consolas" Foreground="#9ece6a" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Генерация" FontSize="11" Foreground="#888" />
                            <TextBlock Text="{Binding PredictedTps}" FontSize="16" FontFamily="Consolas" Foreground="#9ece6a" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Макс. промпт (за жизнь сервера)" FontSize="11" Foreground="#888" />
                            <TextBlock Text="{Binding MaxPromptTokens}" FontSize="16" FontFamily="Consolas" Foreground="#7aa2f7" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TpsWindow}" FontSize="11" Margin="0,6,0,0" Foreground="#888" />
                    <TextBlock Text="{Binding MetricsStatus}" FontSize="11" Margin="0,2,0,0" Foreground="#888" />
                </StackPanel>
            </Border>

            <!-- Последние сборки -->
            <TextBlock Text="Последние сборки (саморебилд)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
            <Border Background="#16181d" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding RecentBuilds}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" Margin="0,2" Background="#1f2733">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Timestamp, StringFormat='  {0:HH:mm:ss}'}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Status}" Margin="8,0,0,0"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FailureReason}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="#e06c75"
                                               Visibility="{Binding FailureReason, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text="{Binding OutputTail}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               FontSize="10" Foreground="#888" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Крахи: картина «что случилось и почему» без ручного копания в logs/ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Крахи (приложение + лаунчер)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                <Button Content="Открыть папку логов" Command="{Binding OpenLogsFolderCommand}"
                        HorizontalAlignment="Left" Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center" />
            </StackPanel>
            <Border Background="#16181d" BorderBrush="#444" BorderThickness="1" Padding="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding CrashEntries}"
                             SelectedItem="{Binding SelectedCrash, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Foreground="#e0e0e0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" Margin="0,2" Background="#1f2733">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Time}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Channel}" Margin="8,0,0,0"
                                                       Foreground="#7aa2f7" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Source}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11" />
                                        <TextBlock Text="{Binding Process}" Margin="0,1,0,0" FontSize="10" Foreground="#888" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedCrashText, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#0d0f13" Foreground="#c0c0c0"
                             BorderBrush="#333" BorderThickness="1" />
                </Grid>
            </Border>

            <!-- Память -->
            <TextBlock Text="{Binding MemoryCount, StringFormat='Память: {0} фактов'}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
            <Border Background="#16181d" BorderBrush="#444" BorderThickness="1" Padding="8">
                <ItemsControl ItemsSource="{Binding RecentMemories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" Margin="0,2" Background="#1f2733">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='  {0:MM.dd HH:mm}'}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Content}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11"
                                               Foreground="#c0c0c0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
