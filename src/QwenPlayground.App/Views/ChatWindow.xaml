<Window x:Class="QwenPlayground.App.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QwenPlayground.App.Views"
        Title="Чат" Height="700" Width="900">
    <!-- DataContext: ChatWindowViewModel (IChatHost) — ChatView резолвит Chat через интерфейс,
         биндинги DataContext.Chat.* (контекстные меню) идут через Window. -->
    <views:ChatView DataContext="{Binding Chat}" />
</Window>
