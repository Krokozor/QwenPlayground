<Window x:Class="QwenPlayground.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение" Height="220" Width="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="QuestionText" Grid.Row="0" TextWrapping="Wrap" FontFamily="Consolas" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Разрешить" Width="100" Margin="4,0,0,0" Click="OnAllow" IsDefault="True" />
            <Button Content="Запретить" Width="100" Margin="4,0,0,0" Click="OnDeny" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
