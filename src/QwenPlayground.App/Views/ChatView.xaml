<UserControl x:Class="QwenPlayground.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QwenPlayground.App.ViewModels"
             xmlns:views="clr-namespace:QwenPlayground.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <views:TodoDoneBrushConverter x:Key="TodoDoneBrush" />
        <views:TodoDoneDecorationsConverter x:Key="TodoDoneDecorations" />
        <views:SubagentStatusTextConverter x:Key="SubagentStatusText" />
        <views:HalfHeightConverter x:Key="HalfHeight" />
        <views:EmbeddedInputVisibilityConverter x:Key="EmbeddedInputVis" />
    <ItemsPanelTemplate x:Key="AttachPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Чип неотправленного вложения. Кликабелен целиком (кнопка «×» — сосед, а не
             вложенная кнопка: WPF запрещает Button внутри Button). Картинка рисуется по
             HasPreview, а не по IsImage, — иначе неудачный декод давал пустой Image на
             почти чёрном фоне карточки, то есть «чёрный скриншот». -->
        <DataTemplate x:Key="AttachChip" DataType="{x:Type vm:PendingAttachment}">
            <Border Background="#1f2733" BorderBrush="#3a5a7a" BorderThickness="1" CornerRadius="3"
                    Padding="6,2" Margin="0,0,4,4">
                <StackPanel Orientation="Horizontal">
                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                            Command="{Binding DataContext.Chat.MessageCommands.OpenPendingAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding FullPath}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Preview}" Width="40" Height="40" Stretch="Uniform"
                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding FallbackGlyph}" FontSize="15" Margin="2,0,6,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowFallback, Converter={StaticResource BoolToVis}}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="#e0e0e0" FontSize="11" />
                                <TextBlock Text="{Binding FallbackText}" Foreground="#e0a030" FontSize="9"
                                           Visibility="{Binding IsPreviewBroken, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Content="&#8635;" Padding="2,0" Margin="4,0,0,0" FontSize="11"
                            Foreground="#e5c07b" VerticalAlignment="Center" ToolTip="Перезагрузить превью"
                            Command="{Binding ReloadPreviewCommand}"
                            Visibility="{Binding IsPreviewBroken, Converter={StaticResource BoolToVis}}" />
                    <Button Content="&#215;" Padding="2,0" Margin="4,0,0,0" FontSize="10" Foreground="#e06c75"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.Chat.MessageCommands.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- LastChildFill=False: иначе последний элемент растягивается на весь остаток ширины.
             Встроенный режим (чат субагента в пузыре): тулбар не нужен — скрыт. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False"
                   Visibility="{Binding Embedded, RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBoolToVis}}">
            <!-- Селектор сессий + настройка чата: только в главном окне (ShowSessionPicker).
                 Закреплённое окно (субагент, Pinned) за своей сессией — переключать нечем. -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ShowSessionPicker, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Сессия:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding SessionList.Sessions}" SelectedItem="{Binding SessionList.SelectedSession}"
                          DisplayMemberPath="Title" Width="220" Margin="0,0,4,0" />
                <Button Content="+" Command="{Binding SessionList.NewSessionCommand}" Padding="8,0" Margin="0,0,4,0" />
                <!-- «×» виден только для не-main сессий: main удалить нельзя (подтверждение — в команде). -->
                <Button Content="&#215;" Command="{Binding SessionList.DeleteSessionCommand}" Padding="8,0" Margin="0,0,12,0"
                        ToolTip="Удалить сессию (с подтверждением)"
                        Visibility="{Binding SessionList.CanDeleteSelectedSession, Converter={StaticResource BoolToVis}}" />
                <!-- Настройка чата: назначение кусков профиля (семплер / промпт / state-блок) -->
                <Button Content="&#9881;" Command="{Binding OpenChatTuningCommand}" Padding="8,0" Margin="0,0,12,0"
                        ToolTip="Настройка чата: семплер, промпт, state-блок (профили из config/chat-profiles.json). Для main-сессии не действует." />
                <!-- Слот llama.cpp сессии: KV-кеш живёт в слоте сессии → переключение между
                     сессиями (каждая на своём слоте) не вытесняет чужие кэши. «—» = LRU сервера.
                     Суммаризация/компакция идут на этом же слоте (контекст сессии меняется
                     в любом случае — отдельный сервисный слот раздувал бы KV-пул). -->
                <TextBlock Text="Слот:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="104" Margin="0,0,4,0"
                          ItemsSource="{Binding SessionList.SlotOptions}"
                          SelectedItem="{Binding SessionList.SelectedSlot}"
                          ToolTip="Слот llama.cpp для ходов этой сессии (и суммаризации). Схема: 0 — main, 1-2 — окна (1 — дефолт не-main, 2 — разводка). 3 (субагент) и 4 (пробы) — зарезервированы. «—» — сервер выбирает сам (LRU)." />
                <!-- «✕» — вычистить KV слота текущей сессии (осознанный сброс кэша). -->
                <Button Content="&#215;" Command="{Binding SessionList.EraseCurrentSlotCommand}" Padding="8,0" Margin="0,0,12,0"
                        ToolTip="Вычистить KV слота текущей сессии: следующий ход пере-евалюирует промпт (сброс кэша)" />
                <!-- Рабочая папка сессии (root инструментов, план 2026-10-01): своя папка
                     или глобальный дефолт (пустое поле). «…» — пикер, Enter — применить,
                     «✕» — сброс к дефолту. Папку НЕ создаём: валидация — только существование. -->
                <TextBlock Text="Папка:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="SessionRootBox" Width="150" Margin="0,0,4,0" VerticalContentAlignment="Center"
                         Text="{Binding SessionList.SessionRoot, UpdateSourceTrigger=LostFocus}"
                         KeyDown="SessionRootBox_KeyDown"
                         ToolTip="Рабочая папка этой сессии (root инструментов): относительные пути file-тулов и cwd shell. Пусто — глобальный дефолт из настроек. Enter — применить (папка должна существовать)." />
                <Button Content="…" Command="{Binding SessionList.BrowseSessionRootCommand}" Padding="8,0" Margin="0,0,4,0"
                        ToolTip="Выбрать рабочую папку (существующую)" />
                <Button Content="&#215;" Command="{Binding SessionList.ClearSessionRootCommand}" Padding="8,0" Margin="0,0,12,0"
                        ToolTip="Сбросить рабочую папку (вернуться к глобальному дефолту)" />
                <TextBlock Text="{Binding SessionList.SessionRootError}" Foreground="#FF5555" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding SessionList.HasSessionRootError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <!-- Полки (группы инструментов): тот же механизм, что и у тулов агента
                 activate/deactivate_shelf. Отметка — немедленная активация, снятие — staged
                 (снимется при ближайшей естественной смене промпта). Состояние per-session.
                 Меню — отдельный UserControl (ShelfMenu) в собственном Popup, не ContextMenu:
                 дефолтный Aero2-шаблон ContextMenu рендерил артефакт (белый блок слева), а
                 отдельный контрол проще инспектировать и править. -->
            <Button x:Name="ShelfButton" Padding="8,0" Margin="0,0,12,0" Click="ShelfButton_Click"
                    ToolTip="Полки (группы инструментов): отметка — сразу, снятие — при следующей смене промпта. По умолчанию всё выключено.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F5C4;" FontSize="14" />
                    <TextBlock Text="{Binding Shelves.ShelfCount}" Margin="5,0,0,0" FontSize="11" Foreground="#648CFF"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasActiveShelves, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Button>
            <!-- Попап меню: закрывается на любой клик вне (StaysOpen=False), DataContext
                 наследует от тулбара (MainViewModel). -->
            <Popup x:Name="ShelfPopup" PlacementTarget="{Binding ElementName=ShelfButton}"
                   Placement="Bottom" VerticalOffset="2" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade" Closed="ShelfPopup_Closed">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="3" Margin="8">
                    <views:ShelfMenu DataContext="{Binding Shelves}" />
                </Border>
            </Popup>
            <!-- TODO-список сессии (TODO.json): кнопка раскрывает панель над чатом.
                 Бейдж — выполнено/всего (пусто, пока списка нет). Правка из UI идёт с
                 источником «user» — агент в state-напоминании увидит «edited by user». -->
            <Button Command="{Binding Todo.TogglePanelCommand}" Padding="8,0" Margin="0,0,12,0"
                    ToolTip="TODO-список сессии (TODO.json): цели, которые напоминаются в state-блоке. Ручная правка — в панели над чатом.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#9745;" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="TODO" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Todo.CountText}" Margin="5,0,0,0" FontSize="11" Foreground="#648CFF"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Wake — функция main-агента: только в главном окне. -->
            <Button Content="&#9200;" Command="{Binding WakeNowCommand}" ToolTip="Разбудить main-агента: wake-сигнал или heartbeat вне расписания"
                    Padding="8,0" Margin="0,0,4,0"
                    Visibility="{Binding ShowSessionPicker, Converter={StaticResource BoolToVis}}" />
            <Button Content="Сжать" Command="{Binding CompactCommand}" Padding="12,2" Margin="0,0,4,0" />
            <!-- «Сжатие» — открыть панель live-превью сжатия; неактивна, пока в ней пусто. -->
            <Button Content="Сжатие" Command="{Binding ShowCompactionPanelCommand}" Padding="12,2" Margin="0,0,4,0"
                    IsEnabled="{Binding Compaction.HasContent}"
                    ToolTip="Открыть панель сжатия контекста (неактивна, пока в ней нет содержимого)" />
            <!-- «Субагент» — открыть окно субагента (видна, пока окно живо; только главное окно).
                 DataContext тулбара — ChatViewModel (MainWindow: ChatView DataContext={Binding Chat}),
                 а состояние на MainViewModel → биндим через окно. FallbackValue=Collapsed:
                 в pinned-окнах (субагент/побочные) window.DataContext = ChatWindowViewModel —
                 SubagentVisible там нет, и без фолбэка упавшее биндингом Visibility осталось бы
                 по умолчанию Visible. -->
            <Button Content="Субагент"
                    Command="{Binding DataContext.OpenSubagentWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="12,2" Margin="0,0,4,0"
                    Visibility="{Binding DataContext.SubagentVisible, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding DataContext.SubagentTooltip, RelativeSource={RelativeSource AncestorType=Window}}" />
            <!-- DockPanel.Dock: без него последний элемент растягивается на весь остаток ширины. -->
            <Button Content="Скопировать чат" Command="{Binding MessageCommands.CopyChatCommand}" Padding="12,2" DockPanel.Dock="Left" />
            <!-- Desktop cursor position: visible when desktop shelf is active -->
            <TextBlock x:Name="DesktopCursorPos" DockPanel.Dock="Right"
                       Text="(0, 0)" Foreground="#648CFF" FontFamily="Consolas" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="Collapsed"
                       ToolTip="Позиция курсора агента на рабочем столе" />
        </DockPanel>

        <!-- TODO-панель: ручной просмотр/правка списка целей сессии (TODO.json).
             Чекбокс — done/undone, «×» — удалить, текст правится inline (сейв по
             LostFocus), «+»/Enter — добавить. Все правки — с источником «user». -->
        <Border Grid.Row="1" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#8a7a4a" CornerRadius="4"
                Background="#15171c" Padding="6"
                Visibility="{Binding Todo.PanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="&#9745; TODO" Foreground="#e0af68" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Todo.CountText}" Foreground="#888" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button Content="очистить" DockPanel.Dock="Right" Padding="6,0" FontSize="11" Margin="0,0,8,0"
                            Command="{Binding Todo.ClearAllCommand}"
                            ToolTip="Удалить все пункты (TODO.json будет удалён)"
                            Visibility="{Binding Todo.HasItems, Converter={StaticResource BoolToVis}}" />
                    <Button Content="&#215;" DockPanel.Dock="Right" Padding="4,0" FontSize="11"
                            Command="{Binding Todo.CollapsePanelCommand}" ToolTip="Скрыть панель TODO" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Todo.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TodoItemViewModel}">
                                <DockPanel Margin="0,1" LastChildFill="True">
                                    <Button Content="&#215;" DockPanel.Dock="Right" Padding="4,0" FontSize="10"
                                            Foreground="#e06c75" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.Todo.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Удалить пункт" />
                                    <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Number, StringFormat='{}{0}. '}" Foreground="#666"
                                               FontSize="12" VerticalAlignment="Center" Width="26"
                                               TextAlignment="Right" />
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" BorderThickness="0"
                                             Background="Transparent" Foreground="{Binding IsCompleted, Converter={StaticResource TodoDoneBrush}}"
                                             FontSize="13" VerticalAlignment="Center"
                                             TextDecorations="{Binding IsCompleted, Converter={StaticResource TodoDoneDecorations}}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <DockPanel Grid.Row="2" Margin="0,4,0,0" LastChildFill="True">
                    <Button Content="+" DockPanel.Dock="Right" Padding="8,0" FontSize="12" Margin="6,0,0,0"
                            Command="{Binding Todo.AddItemCommand}" ToolTip="Добавить цель (или Enter)" />
                    <TextBox Text="{Binding Todo.NewItemText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="1" BorderBrush="#3a5a7a" Background="#101318" Foreground="#e0e0e0"
                             Padding="4,2" FontSize="13" VerticalContentAlignment="Center"
                             ToolTip="Новая цель списка TODO (Enter — добавить)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Todo.AddItemCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                        <Border Margin="0,4" Padding="8" BorderThickness="1" BorderBrush="#444" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#16181d" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="tool">
                                            <Setter Property="Background" Value="#1c2a20" />
                                            <Setter Property="BorderBrush" Value="#3a7a5a" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="system">
                                            <Setter Property="Background" Value="#23201a" />
                                            <Setter Property="BorderBrush" Value="#8a7a4a" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter Property="Background" Value="#1a1f2a" />
                                            <Setter Property="BorderBrush" Value="#3a5a8a" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="confirm">
                                            <Setter Property="Background" Value="#2a2318" />
                                            <Setter Property="BorderBrush" Value="#8a6a3a" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="#7aa2f7" />
                                    <TextBlock Text="{Binding Timestamp}" Foreground="#887a4a" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding HasTimestamp, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding TokenInfo}" Foreground="#666" FontSize="11"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Visibility="{Binding HasTokenInfo, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding IsSystem, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Content="промпт" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Visibility="{Binding HasPrompt, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.Chat.MessageCommands.InspectPromptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="правка" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.Chat.MessageCommands.EditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="копировать" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.Chat.MessageCommands.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="реролл" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.Chat.MessageCommands.RerollCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="откат" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.Chat.MessageCommands.RollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Text="{Binding Reasoning, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontStyle="Italic"
                                         Foreground="#888" Margin="0,4,0,0" FontSize="13"
                                         Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding ToolCalls}" Margin="0,4,0,0"
                                              Visibility="{Binding HasToolCalls, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                     BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                                                     Foreground="#e0af68" TextWrapping="Wrap" FontSize="13"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Встроенный чат субагента (spawn_subagent): хедер (статус + шеврон +
                                     «⤢» popout) + сворачиваемый ChatView (Embedded: без тулбара).
                                     Чат живёт в пузыре (SubagentChat — VM из SubagentChatRegistry);
                                     окно — опциональный popout на той же VM. -->
                                <Border Margin="0,6,0,0" BorderBrush="#3a5a7a" BorderThickness="1" CornerRadius="4"
                                        Background="#101318"
                                        Visibility="{Binding HasEmbeddedSubagent, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="#151a22" Padding="6,3">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="{Binding SubagentChevron}" Padding="2,0" FontSize="11"
                                                    Command="{Binding ToggleSubagentExpandedCommand}"
                                                    ToolTip="Показать/скрыть чат субагента" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="#8899bb"
                                                       Text="{Binding SubagentChat.IsGenerating, Converter={StaticResource SubagentStatusText}}" />
                                            <Button Grid.Column="2" Content="&#9998;" Padding="6,0" FontSize="11" Margin="8,0,0,0"
                                                    Command="{Binding ToggleSubagentInputCommand}"
                                                    ToolTip="Показать/скрыть ввод субагента (ткнуть, если он в лупе)" />
                                            <Button Grid.Column="3" Content="&#10530;" Padding="6,0" FontSize="11" Margin="8,0,0,0"
                                                    ToolTip="Вырвать чат субагента в отдельное окно"
                                                    Command="{Binding DataContext.Chat.MessageCommands.OpenSubagentWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                        </Border>
                                        <!-- Свёрнутость — от MessageViewModel (корневой Border блока,
                                             DataContext=message), НЕ от SubagentChat (DataContext самого ChatView). -->
                                        <views:ChatView DataContext="{Binding SubagentChat}" Embedded="True"
                                                        MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HalfHeight}}"
                                                        Visibility="{Binding DataContext.IsSubagentExpanded, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource BoolToVis}}" />
                                    </DockPanel>
                                </Border>
                                <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         Margin="0,4,0,0" Foreground="White"
                                         VerticalScrollBarVisibility="Auto">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontSize" Value="13" />
                                            <Style.Triggers>
                                                <!-- Команда в карточке подтверждения — моноширинным, крупнее. -->
                                                <DataTrigger Binding="{Binding Role}" Value="confirm">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                    <Setter Property="FontSize" Value="14" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <!-- Карточка подтверждения (роль "confirm"): состояние + крупные
                                     цветные кнопки + YOLO. Кнопки видны, пока решение не принято;
                                     потом карточка остаётся в истории как запись о решении. -->
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ConfirmState}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding ConfirmStateBrush}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ConfirmResolved, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Content="Разрешить" Padding="24,10" FontSize="14" FontWeight="Bold"
                                                Margin="0,0,8,0" Background="#238636" Foreground="White" BorderBrush="#2ea043"
                                                Command="{Binding DataContext.Chat.MessageCommands.ConfirmAllowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Запретить" Padding="24,10" FontSize="14" FontWeight="Bold"
                                                Background="#da3633" Foreground="White" BorderBrush="#f85149"
                                                Command="{Binding DataContext.Chat.MessageCommands.ConfirmDenyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <CheckBox Content="YOLO: авто-разрешать" VerticalAlignment="Center" Margin="16,0,0,0"
                                                  FontSize="13" IsChecked="{Binding YoloEnabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.Chat.MessageCommands.ConfirmYoloCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  ToolTip="Включить YOLO-режим: опасные команды исполняются без подтверждения (настройка + текущая команда)" />
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0"
                                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MessageAttachment}">
                                            <Border Background="#15171c" BorderBrush="#3a5a7a" BorderThickness="1"
                                                    CornerRadius="3" Margin="0,0,6,6" Padding="3" MaxWidth="340">
                                                <StackPanel>
                                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.Chat.MessageCommands.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Открыть файл">
                                                        <StackPanel>
                                                            <!-- По HasPreview, а не по IsImage: расширение .png не
                                                                 гарантирует читаемый декод, иначе был чёрный бокс. -->
                                                            <Image Source="{Binding Preview}"
                                                                   Height="{x:Static vm:MessageAttachment.MessageAttachmentPreviewHeight}"
                                                                   Width="{Binding PreviewWidth}" Stretch="Uniform" Margin="0,0,0,3"
                                                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                                                            <StackPanel Orientation="Horizontal"
                                                                        Visibility="{Binding ShowFallback, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding FallbackGlyph}" FontSize="16" Foreground="#aaa"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding FallbackText}" FontSize="11" Foreground="#7aa2f7"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="#888" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button Content="&#8635;" Padding="1,0" Margin="6,0,0,0" FontSize="10"
                                                                Foreground="#e5c07b" ToolTip="Перезагрузить превью"
                                                                Command="{Binding ReloadPreviewCommand}"
                                                                Visibility="{Binding IsPreviewBroken, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="0,8,0,0" BorderThickness="1" BorderBrush="#3a5a7a" CornerRadius="4" Padding="6"
                Background="#15171c"
                Visibility="{Binding Compaction.ShowPanel, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Button Content="&#215;" Command="{Binding HideCompactionPanelCommand}"
                            DockPanel.Dock="Right" Padding="4,0" FontSize="11"
                            ToolTip="Скрыть панель (содержимое сохранится; откроется кнопкой «Сжатие» в тулбаре)" />
                    <TextBlock Text="▶ сжатие контекста" Foreground="#7aa2f7" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Compaction.Stage}" Foreground="#888" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </DockPanel>
                <ScrollViewer x:Name="CompactionScroll" Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                              Margin="0,4,0,0">
                    <TextBlock Text="{Binding Compaction.Preview}" FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap" Foreground="#c0c0c0" />
                </ScrollViewer>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="4" ItemsSource="{Binding PendingAttachments}"
                      ItemsPanel="{StaticResource AttachPanel}" ItemTemplate="{StaticResource AttachChip}"
                      Margin="0,4,0,0" />

        <!-- Поле ввода: только текст. Кнопки вложений переехали в нижний тулбар рядом с «усилие» (2026-09-02).
             Встроенный режим (чат субагента): скрыто по дефолту, «✎» в хедере раскрывает (ткань). -->
        <TextBox Grid.Row="5" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 MinHeight="48" MaxHeight="160" VerticalContentAlignment="Top" Padding="6"
                 Margin="0,8,0,0"
                 PreviewKeyDown="OnInputPreviewKeyDown">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
            </TextBox.InputBindings>
            <TextBox.Visibility>
                <MultiBinding Converter="{StaticResource EmbeddedInputVis}">
                    <Binding Path="Embedded" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    <Binding Path="DataContext.ShowSubagentInput" RelativeSource="{RelativeSource AncestorType=Border}" />
                </MultiBinding>
            </TextBox.Visibility>
        </TextBox>

        <!-- Нижний тулбар: усилие + вложения слева, действия справа. Режимы и «Самоподдув» убраны (2026-08-22):
             всегда агент, nag без tool-вызовов отключён. -->
        <Grid Grid.Row="6" Margin="0,6,0,0">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource EmbeddedInputVis}">
                    <Binding Path="Embedded" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    <Binding Path="DataContext.ShowSubagentInput" RelativeSource="{RelativeSource AncestorType=Border}" />
                </MultiBinding>
            </Grid.Visibility>
            <!-- Встроенный режим: усилие/вложения не нужны (остаются только действия). -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        Visibility="{Binding Embedded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}">
                <ComboBox SelectedIndex="{Binding ReasoningEffortIndex}" Width="160">
                    <ComboBoxItem Content="усилие: xhigh (думать много)" />
                    <ComboBoxItem Content="усилие: medium (в меру)" />
                    <ComboBoxItem Content="усилие: low (думать меньше)" />
                </ComboBox>
                <Button Content="+" Command="{Binding MessageCommands.AttachFilesCommand}" ToolTip="Прикрепить файлы"
                        Padding="10,4" Margin="8,0,0,0" FontWeight="Bold" />
                <Button Content="&#128206;" Command="{Binding MessageCommands.PasteImageCommand}"
                        ToolTip="Вставить картинку из буфера (Ctrl+V)" Padding="10,4" Margin="4,0,0,0"
                        FontWeight="Bold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отправить" Command="{Binding SendCommand}"
                        Padding="16,4" Margin="0,0,8,0" />
                <Button Content="Продолжить" Command="{Binding MessageCommands.ContinueCommand}"
                        Padding="16,4" Margin="0,0,8,0" />
                <Button Content="Стоп" Command="{Binding CancelCommand}"
                        Padding="16,4" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="7" Text="{Binding StatusText}" Foreground="#666" FontSize="11" Margin="0,4,0,0" />
    </Grid>
</UserControl>
