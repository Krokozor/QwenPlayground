<UserControl x:Class="QwenPlayground.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QwenPlayground.App.ViewModels"
             xmlns:views="clr-namespace:QwenPlayground.App.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <ItemsPanelTemplate x:Key="AttachPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="AttachChip" DataType="{x:Type vm:PendingAttachment}">
            <Border Background="#1f2733" BorderBrush="#3a5a7a" BorderThickness="1" CornerRadius="3"
                    Padding="6,2" Margin="0,0,4,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Preview}" Width="40" Height="40" Stretch="Uniform"
                           Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="#e0e0e0" FontSize="11"
                                   VerticalAlignment="Center" />
                        <Button Content="&#215;" Padding="2,0" Margin="0,2,0,0" FontSize="10" Foreground="#e06c75"
                                HorizontalAlignment="Left"
                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="BrowserRow" Height="100" MinHeight="50" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Сессия:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                      DisplayMemberPath="Title" Width="220" Margin="0,0,4,0" />
            <Button Content="+" Command="{Binding NewSessionCommand}" Padding="8,0" Margin="0,0,4,0" />
            <Button Content="&#215;" Command="{Binding DeleteSessionCommand}" Padding="8,0" Margin="0,0,12,0" />
            <!-- Настройка чата: назначение кусков профиля (семплер / промпт / state-блок) -->
            <Button Content="&#9881;" Command="{Binding OpenChatTuningCommand}" Padding="8,0" Margin="0,0,12,0"
                    ToolTip="Настройка чата: семплер, промпт, state-блок (профили из config/chat-profiles.json). Для main-сессии не действует." />
            <Button Content="&#9200;" Command="{Binding WakeNowCommand}" ToolTip="Разбудить main-агента: wake-сигнал или heartbeat вне расписания"
                    Padding="8,0" Margin="0,0,4,0" />
            <Button Content="Сжать" Command="{Binding CompactCommand}" Padding="12,2" Margin="0,0,4,0" />
            <Button Content="Очистить" Command="{Binding ClearCommand}" Padding="12,2" Margin="0,0,4,0" />
            <Button Content="Скопировать чат" Command="{Binding CopyChatCommand}" Padding="12,2" />
            <Button x:Name="BrowserToggleBtn" Content="&#127760;" Padding="8,0" Margin="12,0,0,0"
                    Click="BrowserToggle_Click" ToolTip="Показать/скрыть браузер агента" />
        </DockPanel>

        <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                        <Border Margin="0,4" Padding="8" BorderThickness="1" BorderBrush="#444" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#16181d" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="tool">
                                            <Setter Property="Background" Value="#1c2a20" />
                                            <Setter Property="BorderBrush" Value="#3a7a5a" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="system">
                                            <Setter Property="Background" Value="#23201a" />
                                            <Setter Property="BorderBrush" Value="#8a7a4a" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter Property="Background" Value="#1a1f2a" />
                                            <Setter Property="BorderBrush" Value="#3a5a8a" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="#7aa2f7" />
                                    <TextBlock Text="{Binding Timestamp}" Foreground="#887a4a" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding HasTimestamp, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding TokenInfo}" Foreground="#666" FontSize="11"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Visibility="{Binding HasTokenInfo, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding IsSystem, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Content="промпт" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.InspectPromptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="правка" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.EditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="копировать" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="реролл" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.RerollCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="откат" Padding="8,0" Margin="4,0,0,0" FontSize="11"
                                                Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Text="{Binding Reasoning, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontStyle="Italic"
                                         Foreground="#888" Margin="0,4,0,0" FontSize="13"
                                         Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding ToolCalls}" Margin="0,4,0,0"
                                              Visibility="{Binding HasToolCalls, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                     BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                                                     Foreground="#e0af68" TextWrapping="Wrap" FontSize="13"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         Margin="0,4,0,0" Foreground="White" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" />
                                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0"
                                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MessageAttachment}">
                                            <Border Background="#15171c" BorderBrush="#3a5a7a" BorderThickness="1"
                                                    CornerRadius="3" Margin="0,0,6,6" Padding="3" MaxWidth="340">
                                                <StackPanel>
                                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Открыть файл">
                                                        <StackPanel>
                                                            <Image Source="{Binding Preview}"
                                                                   Height="{x:Static vm:MessageAttachment.MessageAttachmentPreviewHeight}"
                                                                   Width="{Binding PreviewWidth}" Stretch="Fill" Margin="0,0,0,3"
                                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                                            <StackPanel Orientation="Horizontal"
                                                                        Visibility="{Binding IsNotImage, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="&#128196;" FontSize="14" Foreground="#aaa"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="открыть" FontSize="11" Foreground="#7aa2f7"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Text="{Binding Name}" Foreground="#888" FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,8,0,0" BorderThickness="1" BorderBrush="#3a5a7a" CornerRadius="4" Padding="6"
                Background="#15171c"
                Visibility="{Binding Compaction.ShowPanel, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock Text="▶ сжатие контекста" Foreground="#7aa2f7" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Compaction.Stage}" Foreground="#888" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </DockPanel>
                <ScrollViewer x:Name="CompactionScroll" Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                              Margin="0,4,0,0">
                    <TextBlock Text="{Binding Compaction.Preview}" FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap" Foreground="#c0c0c0" />
                </ScrollViewer>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding PendingAttachments}"
                      ItemsPanel="{StaticResource AttachPanel}" ItemTemplate="{StaticResource AttachChip}"
                      Margin="0,4,0,0" />

        <!-- Поле ввода: только кнопки вложений + текст. Кнопки действий переехали в нижний тулбар (2026-08-22). -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="+" Command="{Binding AttachFilesCommand}" ToolTip="Прикрепить файлы"
                    Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Bottom" FontWeight="Bold" />
            <Button Grid.Column="1" Content="&#128206;" Command="{Binding PasteImageCommand}"
                    ToolTip="Вставить картинку из буфера (Ctrl+V)" Padding="10,4" Margin="0,0,8,0"
                    VerticalAlignment="Bottom" FontWeight="Bold" />
            <TextBox Grid.Column="2" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                      AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                      MinHeight="48" MaxHeight="160" VerticalContentAlignment="Top" Padding="6"
                      PreviewKeyDown="OnInputPreviewKeyDown">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>

        <!-- Нижний тулбар: усилие слева, действия справа. Режимы и «Самоподдув» убраны (2026-08-22):
             всегда агент, nag без tool-вызовов отключён. -->
        <Grid Grid.Row="5" Margin="0,6,0,0">
            <ComboBox SelectedIndex="{Binding ReasoningEffortIndex}" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="усилие: xhigh (думать много)" />
                <ComboBoxItem Content="усилие: medium (в меру)" />
                <ComboBoxItem Content="усилие: low (думать меньше)" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отправить" Command="{Binding SendCommand}"
                        Padding="16,4" Margin="0,0,8,0" />
                <Button Content="Продолжить" Command="{Binding ContinueCommand}"
                        Padding="16,4" Margin="0,0,8,0" />
                <Button Content="Стоп" Command="{Binding CancelCommand}"
                        Padding="16,4" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="6" Text="{Binding StatusText}" Foreground="#666" FontSize="11" Margin="0,4,0,0" />

        <!-- Browser panel (row 7, always in tree, height controls visibility) -->
        <Grid Grid.Row="7" x:Name="BrowserPanel" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="0" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                          Background="#333" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />
            <Border Grid.Row="1" BorderBrush="#3a5a7a" BorderThickness="1" CornerRadius="3" Background="#0a0a0f">
                <wv2:WebView2 x:Name="AgentBrowser" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
