<UserControl x:Class="QwenPlayground.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QwenPlayground.App.Views"
             xmlns:local="clr-namespace:QwenPlayground.App.Views">
    <UserControl.Resources>
        <!-- Единая метка поля: прижата по вертикали, тусклая, с тултипом у себя. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- Единое текстовое поле (длинное: endpoint, путь, адрес).
             BasedOn на имплицитный тёмный стиль TextBox из Dark.xaml: именованный стиль
             в противном случае ВЫТЕСНЯЕТ имплицитный и TextBox откатывается на системную
             светлую тему (белый фон). -->
        <Style x:Key="TextField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="320" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Единое числовое поле (короткое). -->
        <Style x:Key="NumFieldStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Сетка «лейбл | значение» — единая геометрия всех секций. -->
        <Style x:Key="FieldGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- ── Общее ─────────────────────────────────────────────────────────── -->
            <Expander Header="Общее" IsExpanded="True" Margin="0,0,0,4">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="endpoint"
                               ToolTip="Адрес основного LLM-эндпоинта (OpenAI-совместимый). Сюда идут запросы чата и агентного цикла." />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource TextField}"
                             Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="max tokens"
                               ToolTip="Максимум токенов генерации за один ответ." />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TextField}"
                             local:NumField.Min="1" local:NumField.IsInteger="True"
                             Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="контекст"
                               ToolTip="Размер контекста модели (токенов). Определяет бюджет окна диалога." />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource TextField}"
                             local:NumField.Min="1" local:NumField.IsInteger="True"
                             Text="{Binding ContextSize, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="проект"
                               ToolTip="Корневая папка проекта (workspace). Агент работает с ней по умолчанию." />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource TextField}"
                             Text="{Binding ProjectRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="сжатие: доля хвоста"
                               ToolTip="Какую долю недавних сообщений компактация сохраняет дословно (0–1). Больше — меньше потерь при сжатии." />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource TextField}"
                             local:NumField.Min="0" local:NumField.Max="1"
                             Text="{Binding CompactKeepRatio, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Expander>

            <!-- ── Семплер ───────────────────────────────────────────────────────── -->
            <Expander Header="Семплер" IsExpanded="True" Margin="0,0,0,4">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="temperature"
                               ToolTip="Температура семплирования. 0 — детерминированно, выше — разнообразнее." />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="0"
                             Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="top_p"
                               ToolTip="Ядерное семплирование: кумулятивная вероятность (0–1). Ниже — жёстче обрезка." />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="0" local:NumField.Max="1"
                             Text="{Binding TopP, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="top_k"
                               ToolTip="Рассматривать только топ-K токенов по вероятности. 0/пусто — без обрезки." />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="0" local:NumField.IsInteger="True"
                             Text="{Binding TopK, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="min_p"
                               ToolTip="Минимальная относительная вероятность токена (0–1) к самому вероятному." />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="0" local:NumField.Max="1"
                             Text="{Binding MinP, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="repeat_penalty"
                               ToolTip="Штраф за повторение токенов. 1.0 — без штрафа, больше — сильнее подавляет повторы." />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="0"
                             Text="{Binding RepeatPenalty, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="seed"
                               ToolTip="Фиксация seed для воспроизводимости. Пусто — случайный." />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="0" local:NumField.IsInteger="True"
                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Expander>

            <!-- ── Агент: лимиты цикла ───────────────────────────────────────────── -->
            <Expander Header="Агент: лимиты цикла" IsExpanded="True" Margin="0,0,0,4">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="лимит итераций"
                               ToolTip="Жёсткий потолок шагов агентного цикла (инструмент → повтор). 0 = без лимита (бесконечно)." />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="0" local:NumField.IsInteger="True"
                             Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="sanity: шаг nag"
                               ToolTip="Сколько итераций без самопроверки (sanity_check) до напоминания. 0 = отключено." />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="0" local:NumField.IsInteger="True"
                             Text="{Binding SanityCheckInterval, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Expander>

            <!-- ── Heartbeat ─────────────────────────────────────────────────────── -->
            <Expander Header="Heartbeat (автономные пробуждения)" IsExpanded="True" Margin="0,0,0,4">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="включено"
                               ToolTip="По расписанию агент сам просыпается и проверяет, чем заняться. Сигналы из wake/ обрабатываются вне расписания." />
                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding HeartbeatEnabled}" Margin="0,3"
                              VerticalAlignment="Center"
                              ToolTip="По расписанию агент сам просыпается и проверяет, чем заняться. Сигналы из wake/ обрабатываются вне расписания." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="интервал, мин"
                               ToolTip="Как часто (в минутах) main-агент сам просыпается и проверяет, чем заняться." />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumFieldStyle}"
                             local:NumField.Min="1" local:NumField.IsInteger="True"
                             Text="{Binding HeartbeatIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Expander>

            <!-- ── Самосборка ────────────────────────────────────────────────────── -->
            <Expander Header="Самосборка (rebuild_self)" IsExpanded="True" Margin="0,0,0,4">
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="пуш в GitHub"
                               ToolTip="После успешного rebuild — git push уже закоммиченных коммитов. По умолчанию выкл: коммиты и пуши делает владелец/агент явно." />
                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding PushOnRebuild}" Margin="0,3"
                              VerticalAlignment="Center"
                              ToolTip="После успешного rebuild — git push уже закоммиченных коммитов. По умолчанию выкл: коммиты и пуши делает владелец/агент явно." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="куда пушить"
                               ToolTip="URL или имя remote, в который пушит rebuild_self (для форков: URL своего форка). Пусто — текущий upstream (origin). Действует только при включённом «пуш в GitHub»." />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                             Text="{Binding PushRepo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="URL или имя remote, в который пушит rebuild_self (для форков: URL своего форка). Пусто — текущий upstream (origin). Действует только при включённом «пуш в GitHub»." />
                </Grid>
            </Expander>

            <views:MemorySettingsView />

            <!-- ── Профили чатов: ЕДИНСТВЕННОЕ место редактирования пресетов ─────── -->
            <Expander Header="Профили чатов (config/chat-profiles.json)" IsExpanded="True" Margin="0,4,0,0">
                <views:ProfilesEditorView DataContext="{Binding Profiles}" Margin="0,4,0,2" />
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
