<Window x:Class="QwenPlayground.App.Views.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вопрос агента" Height="260" Width="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="QuestionText" Grid.Row="0" TextWrapping="Wrap" />
        <TextBox x:Name="AnswerBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="56" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Ответить" Width="90" Click="OnAnswer" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
