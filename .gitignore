# .NET build artifacts
bin/
obj/
*.user
*.suo

# Visual Studio / Rider
.vs/
.idea/
*.swp

# Python cache
.ruff_cache/
__pycache__/
*.pyc

# Build/deploy artifacts (root only)
/run/
/launcher/

# Large binaries (download separately, managed by launcher)
ffmpeg/

# User data (root only! — patterns without leading / would also match
# source folders like src/QwenPlayground.Core/Sessions/)
/sessions/

# Траектория main-агента: персонализирована владельцем, приложение создаёт её само
# из нейтрального шаблона (TrajectoryStore.DefaultContent) при первом старте.
/trajectory.md

# Идентичность main-агента: принадлежит юзеру (его среда, модели, конвенции).
# Приложение создаёт нейтральную заглушку (MainAgent.DefaultIdentity) при первом старте.
/main-agent.md

# Дневник main-агента: персональные рабочие эпизоды (DiaryStore дописывает при
# компакции). Файл создаётся сам при первом дописывании.
/diary.md

# Записная книжка проекта (проблемы, changelog, backlog): принадлежит юзеру,
# приложение создаёт нейтральный шаблон (ProjectNotebookStore.DefaultContent)
# при первой сборке промпта, если файла нет.
/refactoring.md
/memories/
/memory_research/
/backups/
/orchestrator/
/wake/

# Logs and temp (root only)
/logs/
/tmp/
/Sandbox/
/screenshots/
/reports/
/QwenMultimodalTest/

# User settings (created on first run)
settings.json

# Launcher config: created on first run with defaults (machine-specific paths
# must not be committed — a test run once polluted the tracked copy).
launcher.json

# Media files in root
/images/
/UI/

# Unity project backup (Korovanir) — не часть QwenPlayground
/FunStuff/

# Misc
_review_*.txt
full-test.log
inspect_unitydll.ps1
ocr_discord_chat.txt
tracer_video.mkv
tv_*.png
/temp/
/tmp-strata/
/woah_frames/
test_output.txt
16905121796286.jpg
QwenPlayground.Launcher.exe.lnk
CodeSanitizerV2.cs
