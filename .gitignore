# .NET build artifacts
bin/
obj/
*.user
*.suo

# Visual Studio / Rider
.vs/
.idea/
*.swp

# Python cache
.ruff_cache/
__pycache__/
*.pyc

# Build/deploy artifacts (root only)
/run/
/launcher/

# Large binaries (download separately, managed by launcher)
ffmpeg/

# User data (root only! — patterns without leading / would also match
# source folders like src/QwenPlayground.Core/Sessions/)
/sessions/

# Траектория main-агента: персонализирована владельцем, приложение создаёт её само
# из нейтрального шаблона (TrajectoryStore.DefaultContent) при первом старте.
/trajectory.md

# Идентичность main-агента: принадлежит юзеру (его среда, модели, конвенции).
# Приложение создаёт нейтральную заглушку (MainAgent.DefaultIdentity) при первом старте.
/main-agent.md

# Дневник main-агента: персональные рабочие эпизоды (DiaryStore дописывает при
# компакции). Файл создаётся сам при первом дописывании.
/diary.md
/memories/
/memory_research/
/backups/
/orchestrator/
/wake/

# Logs and temp (root only)
/logs/
/tmp/
/Sandbox/
/screenshots/
/QwenMultimodalTest/

# User settings (created on first run)
settings.json

# Media files in root
/images/
/UI/

# Misc
test_output.txt
16905121796286.jpg
QwenPlayground.Launcher.exe.lnk
CodeSanitizerV2.cs
*.rar
*.lnk
